{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "canvas": "#121019",
    "panel": "#0f0f1a",
    "raised": "#121124",
    "deep": "#221727",
    "surface": "#201a2f",
    "edge": "#2a1d31",
    "text": "#eee9ff",
    "soft": "#ffeef2",
    "cool": "#dffff8",
    "pink": "#ff91c3",
    "signal": "#ff338f",
    "violet": "#c79eff",
    "mint": "#98e4a7",
    "violet_light_mode": "#7740aa",
    "pink_light_mode": "#ad386d",
    "mint_light_mode": "#197344",
    "cool_light_mode": "#006d80",
    "signal_light_mode": "#c51f6c"
  },
  "theme": {
    "primary": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "secondary": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "accent": {
      "dark": "signal",
      "light": "signal_light_mode"
    },
    "error": {
      "dark": "signal",
      "light": "signal_light_mode"
    },
    "warning": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "success": {
      "dark": "mint",
      "light": "mint_light_mode"
    },
    "info": {
      "dark": "cool",
      "light": "cool_light_mode"
    },
    "text": {
      "dark": "text",
      "light": "canvas"
    },
    "textMuted": {
      "dark": "soft",
      "light": "edge"
    },
    "background": {
      "dark": "canvas",
      "light": "text"
    },
    "backgroundPanel": {
      "dark": "panel",
      "light": "soft"
    },
    "backgroundElement": {
      "dark": "raised",
      "light": "soft"
    },
    "border": {
      "dark": "edge",
      "light": "violet_light_mode"
    },
    "borderActive": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "borderSubtle": {
      "dark": "surface",
      "light": "cool"
    },
    "diffAdded": {
      "dark": "mint",
      "light": "mint_light_mode"
    },
    "diffRemoved": {
      "dark": "signal",
      "light": "signal_light_mode"
    },
    "diffContext": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "diffHunkHeader": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "diffHighlightAdded": {
      "dark": "mint",
      "light": "mint_light_mode"
    },
    "diffHighlightRemoved": {
      "dark": "signal",
      "light": "signal_light_mode"
    },
    "diffAddedBg": {
      "dark": "surface",
      "light": "cool"
    },
    "diffRemovedBg": {
      "dark": "deep",
      "light": "soft"
    },
    "diffContextBg": {
      "dark": "panel",
      "light": "text"
    },
    "diffLineNumber": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "diffAddedLineNumberBg": {
      "dark": "surface",
      "light": "cool"
    },
    "diffRemovedLineNumberBg": {
      "dark": "deep",
      "light": "soft"
    },
    "markdownText": {
      "dark": "text",
      "light": "canvas"
    },
    "markdownHeading": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "markdownLink": {
      "dark": "cool",
      "light": "cool_light_mode"
    },
    "markdownLinkText": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "markdownCode": {
      "dark": "mint",
      "light": "mint_light_mode"
    },
    "markdownBlockQuote": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "markdownEmph": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "markdownStrong": {
      "dark": "soft",
      "light": "deep"
    },
    "markdownHorizontalRule": {
      "dark": "edge",
      "light": "violet_light_mode"
    },
    "markdownListItem": {
      "dark": "signal",
      "light": "signal_light_mode"
    },
    "markdownListEnumeration": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "markdownImage": {
      "dark": "cool",
      "light": "cool_light_mode"
    },
    "markdownImageText": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "markdownCodeBlock": {
      "dark": "soft",
      "light": "canvas"
    },
    "syntaxComment": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "syntaxKeyword": {
      "dark": "pink",
      "light": "pink_light_mode"
    },
    "syntaxFunction": {
      "dark": "cool",
      "light": "cool_light_mode"
    },
    "syntaxVariable": {
      "dark": "text",
      "light": "canvas"
    },
    "syntaxString": {
      "dark": "mint",
      "light": "mint_light_mode"
    },
    "syntaxNumber": {
      "dark": "signal",
      "light": "signal_light_mode"
    },
    "syntaxType": {
      "dark": "cool",
      "light": "cool_light_mode"
    },
    "syntaxOperator": {
      "dark": "violet",
      "light": "violet_light_mode"
    },
    "syntaxPunctuation": {
      "dark": "soft",
      "light": "canvas"
    }
  }
}
