{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "accent",
      "purple",
      "green",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "#14111b",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#14111b",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$text.muted",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "#ff338f"
        },
        "warning": {
          "base": "#ff91c3"
        },
        "success": {
          "base": "#98e4a7"
        },
        "info": {
          "base": "#98e4a7"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#ff338f"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#2a1d31"
    },
    "scrollbar": {
      "base": "#c79eff"
    },
    "diff": {
      "text": {
        "added": "#98e4a7",
        "removed": "#ff338f",
        "context": "#ff91c3",
        "hunkHeader": "#c79eff"
      },
      "background": {
        "added": "#22112A",
        "removed": "#2a1d31",
        "context": "#14111b"
      },
      "highlight": {
        "added": "#98e4a7",
        "removed": "#ff338f"
      },
      "lineNumber": {
        "text": "#ff91c3",
        "background": {
          "added": "#22112A",
          "removed": "#2a1d31"
        }
      }
    },
    "syntax": {
      "comment": "#c79eff",
      "keyword": "#ff91c3",
      "function": "#98e4a7",
      "variable": "#d8d0ea",
      "string": "#98e4a7",
      "number": "#ff338f",
      "type": "#98e4a7",
      "operator": "#c79eff",
      "punctuation": "#c4b6dd"
    },
    "markdown": {
      "text": "#d8d0ea",
      "heading": "#ff91c3",
      "link": "#98e4a7",
      "linkText": "#c79eff",
      "code": "#98e4a7",
      "blockQuote": "#ff91c3",
      "emphasis": "#ff91c3",
      "strong": "#d8d0ea",
      "horizontalRule": "#2a1d31",
      "listItem": "#ff338f",
      "listEnumeration": "#c79eff",
      "image": "#98e4a7",
      "imageText": "#c79eff",
      "codeBlock": "#c4b6dd"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#d8d0ea",
        "200": "#d8d0ea",
        "300": "#cec3e4",
        "400": "#c4b6dd",
