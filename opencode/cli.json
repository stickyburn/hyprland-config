{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "hyprway"
  },
  "keybinds": {
    "leader": "ctrl+g",
    "variant.list": "<leader>e",
    "prompt.editor": "none",
    "command.palette.show": "ctrl+p",
    "session.sidebar.toggle": "ctrl+shift+e",
    "input.undo": "ctrl+z",
    "terminal.suspend": "none"
  },
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "paste": "full"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide",
    "permissions": "autoaccept"
  },
  "animations": true
}
