{
  "theme": {
    "name": "hyprway"
  },
  "keybinds": {
    "leader": "ctrl+g",
    "command.palette.show": "ctrl+p",
    "session.sidebar.toggle": "ctrl+shift+e",
    "input.undo": "ctrl+z,ctrl+-,super+z",
    "input.redo": "ctrl+.,super+shift+z",
    "terminal.suspend": "none"
  },
  "scroll": {
    "acceleration": true
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true
}
