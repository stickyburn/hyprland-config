  "editor.tokenColorCustomizations": {
    "[Visual Studio Dark]": {
      "comments": "#c79eff",
      "strings": "#98e4a7",
      "numbers": "#ff338f",
      "keywords": "#ff91c3",
      "functions": "#98e4a7",
      "types": "#98e4a7",
      "variables": "#eee9ff",
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "fontStyle": "italic",
            "foreground": "#c79eff"
          }
        },
        {
          "scope": [
            "keyword",
            "storage.type",
            "storage.modifier"
          ],
          "settings": {
            "fontStyle": "italic",
            "foreground": "#ff91c3"
          }
        },
        {
          "scope": [
            "punctuation",
            "keyword.operator"
          ],
          "settings": {
            "foreground": "#c79eff"
          }
        }
      ]
    },
    "[Quiet Light]": {
      "comments": "#7740aa",
      "strings": "#197344",
      "numbers": "#bf1d68",
      "keywords": "#a62d68",
      "functions": "#197344",
      "types": "#197344",
      "variables": "#14111B",
      "textMateRules": [
        {
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "fontStyle": "italic",
            "foreground": "#7740aa"
          }
        },
        {
          "scope": [
            "keyword",
            "storage.type",
            "storage.modifier"
          ],
          "settings": {
            "fontStyle": "italic bold",
            "foreground": "#a62d68"
          }
        },
        {
          "scope": [
            "punctuation",
            "keyword.operator"
          ],
          "settings": {
            "foreground": "#7740aa"
          }
        }
      ]
    }
  },
  "editor.semanticTokenColorCustomizations": {
    "[Visual Studio Dark]": {
      "enabled": true,
      "rules": {
        "*": "#eee9ff",
        "comment": {
          "foreground": "#c79eff",
          "italic": true
        },
        "string": "#98e4a7",
        "number": "#ff338f",
        "keyword": {
          "foreground": "#ff91c3",
          "italic": true
        },
        "function": "#98e4a7",
        "method": "#98e4a7",
        "type": "#98e4a7",
        "class": "#98e4a7",
        "operator": "#c79eff"
      }
    },
    "[Quiet Light]": {
      "enabled": true,
      "rules": {
        "*": "#14111B",
        "comment": {
          "foreground": "#7740aa",
          "italic": true
        },
        "string": "#197344",
        "number": "#bf1d68",
        "keyword": {
          "foreground": "#a62d68",
          "bold": true
        },
        "function": "#197344",
        "method": "#197344",
        "type": "#197344",
        "class": "#197344",
        "operator": "#7740aa"
      }
    }
  },
  // remote dev
  "remote.SSH.remotePlatform": {
    "refyne": "linux",
    "runpod": "linux"
  }
}
