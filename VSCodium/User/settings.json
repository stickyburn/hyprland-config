{
  // UI
  "window.zoomLevel": 0,
  "editor.fontFamily": "Zed Mono",
  "terminal.integrated.fontFamily": "Zed Mono",
  "editor.fontSize": 14,
  "terminal.integrated.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "line-thin",
  "editor.inlineSuggest.enabled": true,
  "editor.lineNumbers": "off",
  "editor.tabSize": 2,
  "editor.folding": false,
  "editor.foldingHighlight": false,
  "editor.glyphMargin": false,
  "editor.guides.indentation": false,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.minimap.enabled": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.decorations.colors": false,
  // terminal
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.scrollback": 10000,
  // search
  "search.exclude": {
    "**-lock.yaml": true,
    "**/*.cjs": true,
    "**/*.svg": true,
    "**/.cache": true,
    "**/.next": true,
    "**/@remote-types": true,
    "**/cache": true,
    "**/commit-msg": true,
    "**/dependabot.yml": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/static": true,
    ".yarnrc.yml": true,
    "yarn.lock": true
  },
  // git
  "git.decorations.enabled": false,
  "breadcrumbs.enabled": false,
  "extensions.ignoreRecommendations": true,
  // security — untrusted repo hardening
  "task.allowAutomaticTasks": "off",
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "prompt",
  "json.schemaDownload.enable": true,
  "npm.packageManager": "auto",
  "window.commandCenter": true,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Visual Studio Dark",
  "workbench.editor.decorations.badges": false,
  "workbench.editor.decorations.colors": false,
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.renderSideBySide": false,
  "diffEditor.useInlineViewWhenSpaceIsLimited": false,
  // LSP & formatting
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "js/ts.validate.enabled": false,
  "files.associations": {
    "**/waybar/*.css": "gtk-css",
    "**/wofi/*.css": "gtk-css"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "rust-analyzer.server.path": "/Users/stickyburn/.local/share/cargo/bin/rust-analyzer",
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  // themes
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "Quiet Light",
  "workbench.preferredDarkColorTheme": "Visual Studio Dark",
  "workbench.colorCustomizations": {
