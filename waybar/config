{
    "include": ["~/.config/waybar/common.jsonc"],
    "modules-center": ["ext/workspaces#mango"],
    "ext/workspaces#mango": {
        "format": "{name}",
        "tooltip": false,
        "on-click": "activate",
        "on-scroll-up": "mmsg dispatch viewtoright,0",
        "on-scroll-down": "mmsg dispatch viewtoleft,0",
        "sort-by-name": true,
        "ignore-hidden": true
    },
    "custom/window": {
        "exec": "~/.config/waybar/scripts/mango.sh window",
        "return-type": "json",
        "restart-interval": 2,
        "escape": true,
        "max-length": 32,
        "hide-empty-text": true
    },
    "group/context": {
        "modules": ["custom/window"]
    },
    "custom/idle": {
        "on-click": "~/.config/waybar/scripts/mango.sh sleep"
    }
}
