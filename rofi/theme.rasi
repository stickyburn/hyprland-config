/* Generated from hyprway. */
* {
    background: #14111b;
    panel-bg: #181420;
    elevated-bg: #181420;
    selection-bg: #22112A;
    border: #2a1d31;
    foreground: #d8d0ea;
    foreground-muted: #c4b6dd;
    accent: #ff91c3;
    danger: #ff338f;
    focus: #c79eff;
    success: #98e4a7;
    on-accent: #2a1d31;

    surface: #22112AE6;
    font: "Switzer 10";
    background-color: transparent;
    text-color: @foreground-muted;
}

window {
    width: 28%;
    border: 0px;
    border-radius: 0px;
    background-color: @surface;
    padding: 10px;
}

inputbar {
    children: [ "prompt", "entry" ];
    spacing: 12px;
    background-color: transparent;
    border: 2px solid;
    border-color: @focus;
    border-radius: 7px;
    margin: 2px 2px 12px;
    padding: 11px 14px;
}

prompt {
    text-color: @foreground;
}

entry {
    text-color: @foreground;
    font: "Switzer 12";
}

listview {
    lines: 7;
    fixed-height: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
    spacing: 4px;
}

element {
    border: 0px solid;
    border-radius: 5px;
    margin: 0px 2px;
    padding: 8px 10px;
}

element selected.normal {
    background-color: @focus;
    text-color: @on-accent;
}

element-text {
    vertical-align: 0.5;
    background-color: inherit;
    text-color: inherit;
}

element-icon {
    vertical-align: 0.5;
    background-color: inherit;
    size: 1.8em;
    margin: 0px 11px 0px 0px;
}

message {
    background-color: transparent;
    border: 0px;
}
